# 复制为 .env 后填写。.env 只在宿主侧读取，不会进入电脑（隔离区）。

# 模型提供方：anthropic（默认）、deepseek、openai（任何 OpenAI 兼容接口）。见 host/models.py
SMRA_MODEL_PROVIDER=anthropic
# 模型密钥：只存在于宿主侧的模型代理里。按提供方读 ANTHROPIC_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY，
# 也可以统一写在 SMRA_MODEL_API_KEY
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# 以下不填就用提供方的预设
# SMRA_MODEL=                 # 主模型，如 claude-opus-5-5、deepseek-v4-pro、qwen3-max
# SMRA_GUARD_MODEL=           # 注入检测用的便宜模型，如 claude-haiku-5-5、deepseek-flash
# SMRA_MODEL_UPSTREAM=        # 接口地址，如 https://api.deepseek.com/anthropic、https://openrouter.ai/api/v1
# SMRA_MODEL_PROTOCOL=        # anthropic 或 openai
# SMRA_MODEL_FEATURES=        # 逗号分隔：stream,thinking,effort,cache,betas,compaction,text_editor,web_search,structured_output
# SMRA_MAX_TOKENS=            # 单次回复的长度上限
# SMRA_GUARD_VISION=          # 注入检测的模型能不能看图，1/0；默认按提供方预设
SMRA_EFFORT=medium
# 一次运行最长多少秒
# SMRA_RUN_TIMEOUT_S=600
# 停止（systemctl stop/restart）时最多等手上的运行做完多少秒；systemd 的 TimeoutStopSec 要比它长
# SMRA_STOP_GRACE_S=300

# 宿主一侧的网页搜索，给没有服务端搜索的模型用。选 deepseek 预设时自动打开；
# 别家模型想用，设 SMRA_SEARCH_PROVIDER=deepseek 并填 DEEPSEEK_API_KEY。off 表示关掉
# SMRA_SEARCH_PROVIDER=
# SMRA_SEARCH_UPSTREAM=https://api.deepseek.com/anthropic
# SMRA_SEARCH_API_KEY=        # 不填就用 DEEPSEEK_API_KEY
# SMRA_SEARCH_MODEL=deepseek-flash
# SMRA_SEARCH_MAX_PER_RUN=20

# 你发来的照片：主模型看不了图时，交给能看图的模型写一段说明。默认在主模型看不了图、检查模型能看图时打开
# SMRA_DESCRIBE_IMAGES=
# SMRA_VISION_MODEL=          # 空表示用注入检测的模型
# 你发来的语音：OpenAI 兼容的语音识别接口。不填密钥就不转文字。只填密钥时用 OpenAI；
# 国内可以用硅基流动：SMRA_STT_UPSTREAM=https://api.siliconflow.cn/v1，SMRA_STT_MODEL=FunAudioLLM/SenseVoiceSmall
# SMRA_STT_API_KEY=
# SMRA_STT_UPSTREAM=
# SMRA_STT_MODEL=whisper-1

# 数据目录（数据库、记忆、上传、快照）。默认是仓库下的 data/
# SMRA_DATA_DIR=

# 电脑驱动：docker（隔离）或 local（不隔离，仅供开发）
SMRA_DRIVER=docker

# 只对 local 驱动有效。设为 1 才给 Agent 命令行工具，这意味着模型生成的命令
# 会直接在这台机器上以你的身份执行。docker 驱动下命令行总是可用（在容器里执行）。
SMRA_LOCAL_EXEC=0

# 宿主接口与模型代理的监听地址。Linux 上用 docker 驱动时需要改成 0.0.0.0 或网桥地址
SMRA_BIND=127.0.0.1
SMRA_PORT=8787
# 出网代理的端口。电脑里的一切网络请求都经过它
SMRA_EGRESS_PORT=8788

# 加密外部账号凭证的主密钥（Fernet 密钥）。按这个顺序找：systemd 加密凭证（LoadCredentialEncrypted=smra-master-key:…）
# → SMRA_MASTER_KEY → SMRA_MASTER_KEY_CRED 指向的加密凭证文件（命令行用，调 systemd-creds 解密）→ 数据目录里的 master.key。
# 都没有就在数据目录生成 master.key；Linux 上建议挪进 systemd 加密凭证，步骤见 docs/security.md 的"主密钥别和数据库放一起"。
# 生成：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMRA_MASTER_KEY=
# SMRA_MASTER_KEY_CRED=/etc/credstore.encrypted/smra-master-key

# 注入检测：用便宜的模型检查读到的外部内容里有没有针对 AI 的指令。每次有新工具结果时多一次小调用
SMRA_INJECTION_CHECK=1

# 预算（token）
SMRA_RUN_TOKEN_BUDGET=200000
SMRA_DAILY_TOKEN_BUDGET=2000000
# 缓存读取按这个比例计入以上预算和任务预算（0 到 1）。按你用的模型的缓存价格调
SMRA_CACHE_READ_WEIGHT=0.1

# 长对话压缩（提供方没有服务端压缩时，比如 DeepSeek）：会话超过 SMRA_COMPACT_AT token 时，
# 运行前把较早的部分写成摘要，最近约 SMRA_COMPACT_KEEP token 原样保留。0 表示不压缩。见 host/compact.py
SMRA_COMPACT_AT=100000
SMRA_COMPACT_KEEP=20000

# 定时器总数上限（Agent 和你设的合计，不含内置的夜间整理）
SMRA_TIMER_MAX=50
# 夜间整理的时间（cron，本地时间）。留空就不建；建了之后可以用 /cancel 取消
SMRA_CONSOLIDATE_CRON=30 3 * * *
# 固定会话的日程（same_session）同一个会话最多接几次，之后换新会话
SMRA_SCHEDULE_SESSION_FIRES=10

# 数据保留天数，0 表示永久保留。每天清一次，见 host/retention.py
# 模型请求日志的请求和回复正文（含邮件等明文）；花费一直留着
SMRA_RETAIN_INFERENCE_DAYS=14
# 已关闭会话的记录、处理完的收件箱/发件箱/审批、出网记录
SMRA_RETAIN_DAYS=365
# data/uploads、data/outgoing 里的暂存文件
SMRA_RETAIN_FILE_DAYS=30

# 发件节奏。只能在这里改，Agent 改不了
# 后台运行每天最多几条即时通知，超出的降为摘要
SMRA_NOTIFY_DAILY_CAP=3
# 安静时段（本地时间），期间即时通知和系统提醒延后到结束时。留空表示没有
SMRA_QUIET_HOURS=23:00-08:00
# 摘要的送达时间，逗号分隔
SMRA_DIGEST_TIMES=08:00

# Webhook 接收端，单独的端口。外部系统要打进来时，用隧道只暴露这个端口，不要暴露 8787。
# 来源和密钥在 data/webhooks.yaml 里配置（格式见 host/webhooks.py）。-1 表示不开
SMRA_WEBHOOK_BIND=127.0.0.1
SMRA_WEBHOOK_PORT=8789

# 浏览器（第 7 步）。local：宿主上的独立浏览器进程；off：不开；
# docker：浏览器跑在只接内部网络的容器里（Linux 上建议这个），登录状态存在 data/browser/state.json。
#   镜像 smra-browser:<Playwright 版本> 第一次用时自动构建（几分钟），也可以先手动建，见 browser/Dockerfile
# 通道：chromium（先 uv run playwright install chromium）/ msedge / chrome（用本机已装的）；docker 模式下不用
SMRA_BROWSER=local
# docker 模式下浏览器容器的资源上限。和别的服务共用机器时调低
# SMRA_BROWSER_MEMORY=1536m
# SMRA_BROWSER_CPUS=1.5
# SMRA_BROWSER_CPU_SHARES=512
SMRA_BROWSER_CHANNEL=chromium
SMRA_BROWSER_HEADLESS=1
# 录下浏览器画面（做演示用）：填一个目录就开。视频在浏览器关掉时（宿主停下时）写完。默认不录
SMRA_BROWSER_RECORD_DIR=
# 给你看的页面：浏览器接管（你在这里亲手登录）和 /activity 的活动记录。单独的端口，-1 表示不开；
# 从手机上用时，用隧道只暴露它，并把外部地址填进 SMRA_TAKEOVER_URL
SMRA_TAKEOVER_BIND=127.0.0.1
SMRA_TAKEOVER_PORT=8790
SMRA_TAKEOVER_URL=

# 多角色（第 8 步）。角色说明放在 data/core/roles/<名字>.md；没点名的消息交给默认角色
SMRA_DEFAULT_ROLE=coordinator
# 一条消息引发的交接最多几跳；一个任务（含所有交接）的总花费上限（token）
SMRA_HANDOFF_MAX_HOPS=5
SMRA_TASK_TOKEN_BUDGET=600000

# 休眠（第 9 步）：最后一次运行后空闲多少秒挂起电脑（-1 不挂起）；Agent 请求保持清醒的上限（秒）
SMRA_IDLE_SUSPEND_S=600
SMRA_KEEP_AWAKE_MAX_S=14400

# microVM 驱动（SMRA_DRIVER=firecracker）。镜像和程序由 sh cell/vm/build-images.sh 准备到 data/vm/ 和 bin/
# 经 jailer 启动要求宿主是 root；设 0 以当前用户直接启动（要能读写 /dev/kvm）
SMRA_FC_JAILER=1
SMRA_FC_VCPUS=2
SMRA_FC_MEM_MIB=2048
SMRA_FC_HOME_GIB=8
# 以下不填就用默认：程序在 bin/，镜像在 data/vm/，监禁目录在 data/vm/jail，监视器用 10000 号用户
# SMRA_FC_BIN=
# SMRA_FC_JAILER_BIN=
# SMRA_FC_KERNEL=
# SMRA_FC_ROOTFS=
# SMRA_FC_CHROOT_BASE=
# SMRA_FC_UID=10000
# SMRA_FC_GID=10000

# Telegram（--channel telegram 时需要）
TELEGRAM_BOT_TOKEN=
# 只接受这个 chat id 的消息。留空时启动后给机器人发一条消息，日志里会打印出 chat id
TELEGRAM_CHAT_ID=

# Docker 电脑的资源上限（和别的服务共用机器时调低）
# SMRA_CELL_CPUS=2
# SMRA_CELL_MEMORY=2g
# SMRA_CELL_CPU_SHARES=1024
